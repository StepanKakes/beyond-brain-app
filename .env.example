# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# BEYOND BRAIN
# =============================================================================

# Path to the beyond-brain (data) repo on disk. Used both as cwd for Claude
# SDK and as source for /api/beyond/clients sidebar data. Default fallback
# resolves to ~/Documents/GitHub/beyond-brain when unset.
# BEYOND_BRAIN_PATH=C:\Users\you\path\to\beyond-brain

# Shared secret between n8n (Telegram agent) and the backend. Anyone with
# this token can talk to /api/beyond-agent/* without a browser login —
# treat as a credential. Generate ~32 bytes of hex.
# BEYOND_AGENT_TOKEN=

# Optional allow-list of Telegram numeric user IDs (comma-separated). When
# set, the backend rejects agent calls whose meta.telegramUserId is not in
# this list. Leave empty to accept any caller that has the token.
# BEYOND_AGENT_ALLOWED_TG_USERS=

# Telegram bot token. Two things use it: the agent route posts live progress and
# the final answer straight into the chat (which is what lets /query ack in 202
# and dodge Cloudflare's 100 s timeout), and the scheduler delivers the morning
# brief and the pre-call reminder.
# BEYOND_TG_BOT_TOKEN=

# Where the morning brief and the hour-before-a-call reminder land. A group both
# people are in is the simplest answer; per-person delivery is possible via
# `tgChatId` in BEYOND_PEOPLE. Without this the brief is still written into the
# brain, it just does not reach a phone, and the run log says so.
# BEYOND_TG_CHAT_ID=

# WhatsApp, for sending an approved draft to a client. Falls back to the WAHA
# MCP entry in ~/.claude.json, so on a box where the agent already uses WAHA
# neither of these is needed. Without them drafts are still written and
# readable, they just cannot be sent.
# BEYOND_WAHA_URL=https://waha.example.com
# BEYOND_WAHA_API_KEY=

# `0` stops every scheduled job. The app still serves the dashboards.
# BEYOND_SCHEDULER=0

# Where failures go (three in a row, once). Without it they go to the same
# chat as the brief.
# BEYOND_TG_ERROR_CHAT_ID=

# Secrets for the event routes in the brain's system/udalosti.json. Each
# route names its env var; BEYOND_EVENT_SECRET is the shared fallback.
# WAHA: the same value as WHATSAPP_HOOK_HMAC_KEY on the WAHA side.
# BEYOND_EVENT_SECRET_WAHA=
# BEYOND_EVENT_SECRET_CALCOM=
# BEYOND_EVENT_SECRET_N8N=
# BEYOND_EVENT_SECRET=

# Model for the evening learning review (reads a lot, writes little).
# BEYOND_REVIEW_MODEL=sonnet

# Telegram bot inside the app (long polling) instead of the n8n webhook.
# Exclusive: turning this on deletes the bot's webhook, so n8n's Telegram
# Inbound stops receiving. Voice notes use the brain's whisper script, or
# OPENAI_API_KEY as fallback.
# BEYOND_TG_POLLING=1

# How many client sync turns run at once (1 to 4). Default 2.
# BEYOND_SYNC_PARALLEL=2

# Raw pulls (replacing the n8n workflows). Notion integration token with
# access to Clients 1:1 and the client dashboards/DBs; WAHA comes from
# BEYOND_WAHA_URL/BEYOND_WAHA_API_KEY above.
# BEYOND_NOTION_TOKEN=
# BEYOND_NOTION_CLIENTS_DB=341d27608c3080869916c2b2017ef085
# BEYOND_WAHA_SESSION=default

# Start a fresh Claude session when a Telegram thread has been idle this long,
# so one chat's JSONL doesn't grow forever and pay full cache_creation on every
# turn. Default 3600000 (1 h). `0` disables.
# BEYOND_AGENT_IDLE_RESET_MS=3600000

# Coalesce duplicate inbound agent requests by (chatId, messageId) for this
# window — Telegram retries a webhook every 60 s and the SDK is slower than
# that. Default 600000 (10 min). `0` disables.
# BEYOND_AGENT_IDEMPOTENCY_MS=600000

# Public origin of this install (no trailing slash). Used to build the MCP
# OAuth redirect URI; falls back to the request's own host when unset.
# BEYOND_PUBLIC_URL=https://brain.example.com

# Extra roots (comma/semicolon-separated) the file preview may open besides the
# brain repo and the temp dir. Widens what the browser can read — keep tight.
# BEYOND_OPEN_FILE_ROOTS=

# Health URL for the n8n status dot in the sidebar. Unset = "nepřipojeno".
# BEYOND_N8N_HEALTH=https://n8n.example.com/healthz

# Cal.com API key. Drives the Hovory screen, today's calls on the velín and the
# "právě běží" banner. Bookings are matched to clients by the attendee's e-mail,
# which profil.md records. Without it those surfaces say they are not connected
# rather than showing an empty calendar, which would read as "no calls booked".
# BEYOND_CALCOM_API_KEY=

# Who "we" are, as JSON, when a third person joins. Maps a login and a Cal.com
# host onto the name the brain uses in _action-items.md headings. Defaults to
# Tim and Štěpán; see server/services/beyond-people.js.
# BEYOND_PEOPLE=[{"key":"tim","displayName":"Tim","aliases":["tim"],"usernames":["tim"],"calcomEmail":"..."}]

# --- Chat session tuning (defaults are fine) ---------------------------------

# Context window the composer chip measures against. Default 200000.
# BEYOND_TOKEN_BUDGET_TOTAL=200000

# Where the SDK auto-compacts. Defaults to 80 % of the budget above.
# BEYOND_AUTO_COMPACT_THRESHOLD=

# How long a live chat process survives without a socket. Default 1800000
# (30 min).
# BEYOND_SESSION_IDLE_MS=1800000

# Grace period before a dropped WebSocket is treated as gone, so a backgrounded
# tab or a reload re-attaches to the running turn instead of killing it.
# Default 300000 (5 min).
# BEYOND_WS_GRACE_MS=300000

# `0` hands the agent the full MCP tool set instead of the curated one.
# BEYOND_STRICT_MCP=

# `0` turns off streaming input (send the whole prompt at once).
# BEYOND_STREAMING_INPUT=


